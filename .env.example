# Copie este arquivo para .env e preencha os valores.
# Nunca commite o arquivo .env.

GEMINI_API_KEY=

# App em https://developer.spotify.com/dashboard
# Redirect URI não é necessária para só tocar no app desktop (Client Credentials).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AccessFlow — sensor de luz (Arduino)
# Vazio = detecta a porta sozinho. SIMULADO = testa sem Arduino.
SENSOR_PORTA=
SENSOR_LOCAL=corredor de acesso da clínica
